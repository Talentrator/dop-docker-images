// stm32f072b_disco for the grader and the board check: Renode 1.17's platforms/cpus/stm32f0.repl,
// platforms/cpus/stm32f072.repl and platforms/boards/stm32f072b_discovery.repl in one file. Include
// ../STMCANZephyr.cs and STM32_TimerZephyr.cs before loading. Changed from Renode's files:
//   - SysTick at 48 MHz (Renode's file: 72 MHz); Zephyr runs this board at 48 MHz.
//   - CPU at 48 MIPS (Renode's file sets none, so 100).
//   - Timers as STM32_TimerZephyr (period ARR + 1) at 48 MHz, Zephyr's timer clock (APB /1).
//   - bxCAN as CAN.STMCANZephyr, its four interrupt lines combined into the chip's one (CEC_CAN,
//     30); Renode's file connects none.
//   - I2C1 and I2C2 interrupts connected (I2C1 23, I2C2 24, event and error combined); Renode's
//     file connects none, so Zephyr's interrupt-driven I2C driver waited forever in its first
//     transfer and the firmware never reached main.
//   - IWDG added (Renode's file only tags its address), on the 40 kHz LSI as Zephyr assumes.
//   - SYSCFG added and every GPIO pin routed through it to EXTI, as for stm32f4_disco: the timer
//     alternate-function blocks re-declare pins and dropped their EXTI route.

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 48000000
    IRQ -> cpu@0

syscfg: Miscellaneous.STM32_SYSCFG @ sysbus 0x40010000
    [0-15] -> exti@[0-15]

exti: IRQControllers.STM32F4_EXTI @ sysbus 0x40010400
    numberOfOutputLines: 32
    [0-3] -> nvic@[5, 5, 6, 6]
    [4-15] -> nvicInput7@[0-11]
    18 -> nvic@31
    [21-23] -> nvic@[12, 12, 23]
    [25-28] -> nvic@[27, 28, 30, 29]

nvicInput7: Miscellaneous.CombinedInput @ none
    numberOfInputs: 12
    -> nvic@7

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m0"
    PerformanceInMips: 48
    nvic: nvic

usart1: UART.STM32F7_USART @ sysbus 0x40013800
    frequency: 200000000
    IRQ -> nvic@27 | dma@2 | dma@4  // depends on SYSCFG_CFGR1
    ReceiveDmaRequest -> dma@3 | dma@5  // depends on SYSCFG_CFGR1

usart2: UART.STM32F7_USART @ sysbus 0x40004400
    frequency: 200000000
    IRQ -> nvic@28 | dma@4
    ReceiveDmaRequest -> dma@5

usart3: UART.STM32F7_USART @ sysbus 0x40004800
    frequency: 200000000
    IRQ -> nvic@29 | dma@2  // depends on SYSCFG_CFGR1
    ReceiveDmaRequest -> dma@3  // depends on SYSCFG_CFGR1

usart4: UART.STM32F7_USART @ sysbus 0x40004C00
    frequency: 200000000
    IRQ -> nvic@29

usart5: UART.STM32F7_USART @ sysbus 0x40005000
    frequency: 200000000
    IRQ -> nvic@29

usart6: UART.STM32F7_USART @ sysbus 0x40011400
    frequency: 200000000
    IRQ -> nvic@29

usart7: UART.STM32F7_USART @ sysbus 0x40011800
    frequency: 200000000
    IRQ -> nvic@29

gpioPortA: GPIOPort.STM32_GPIOPort @ sysbus <0x48000000, +0x400>
    modeResetValue: 0x28000000
    pullUpPullDownResetValue: 0x24000000
    numberOfAFs: 8
    invertedAFPins: [[1, 5], [7, 2]]
    [0-15] -> syscfg#0@[0-15]

gpioPortB: GPIOPort.STM32_GPIOPort @ sysbus <0x48000400, +0x400>
    modeResetValue: 0x00000000
    pullUpPullDownResetValue: 0x00000000
    numberOfAFs: 8
    invertedAFPins: [[0, 2], [1, 2], [6, 2], [7, 2], [13, 2], [14, 2], [15, 2, 3]]
    [0-15] -> syscfg#1@[0-15]

gpioPortC: GPIOPort.STM32_GPIOPort @ sysbus <0x48000800, +0x400>
    modeResetValue: 0x00000000
    pullUpPullDownResetValue: 0x00000000
    numberOfAFs: 8
    [0-15] -> syscfg#2@[0-15]

gpioPortD: GPIOPort.STM32_GPIOPort @ sysbus <0x48000C00, +0x400>
    modeResetValue: 0x00000000
    pullUpPullDownResetValue: 0x00000000
    numberOfAFs: 8
    [0-15] -> syscfg#3@[0-15]

gpioPortE: GPIOPort.STM32_GPIOPort @ sysbus <0x48001000, +0x400>
    modeResetValue: 0x00000000
    pullUpPullDownResetValue: 0x00000000
    numberOfAFs: 8
    [0-15] -> syscfg#4@[0-15]

gpioPortF: GPIOPort.STM32_GPIOPort @ sysbus <0x48001400, +0x400>
    modeResetValue: 0x28000000
    pullUpPullDownResetValue: 0x24000000
    numberOfAFs: 8
    [0-15] -> syscfg#5@[0-15]

i2c1: I2C.STM32F7_I2C @ sysbus 0x40005400
    DmaReceive-> dma@3
    EventInterrupt -> i2c1Irq@0
    ErrorInterrupt -> i2c1Irq@1

i2c1Irq: Miscellaneous.CombinedInput @ none
    numberOfInputs: 2
    -> nvic@23

i2c2: I2C.STM32F7_I2C @ sysbus 0x40005800
    DmaReceive-> dma@5
    EventInterrupt -> i2c2Irq@0
    ErrorInterrupt -> i2c2Irq@1

i2c2Irq: Miscellaneous.CombinedInput @ none
    numberOfInputs: 2
    -> nvic@24

spi1: SPI.STM32SPI @ sysbus 0x40013000
    series: STM32Series.F0
    IRQ -> nvic@25
    DMAReceive -> dma@2
    DMASend -> dma@3

spi2: SPI.STM32SPI @ sysbus 0x40003800
    series: STM32Series.F0
    IRQ -> nvic@26
    DMAReceive -> dma@4
    DMASend -> dma@5

timer1: Timers.STM32_TimerZephyr @ sysbus 0x40012C00
    frequency: 48000000
    initialLimit: 0xFFFF
    TriggerInterrupt -> nvic@13 | dma@4
    CommutationInterrupt -> nvic@13 | dma@4
    UpdateInterrupt -> nvic@13 | dma@5
    BreakInterrupt -> nvic@13
    CaptureCompareInterrupt -> nvic@14
    [0, 1, 3, 2] -> dma@[2-5]

timer2: Timers.STM32_TimerZephyr @ sysbus 0x40000000
    frequency: 48000000
    initialLimit: 0xFFFFFFFF
    -> nvic@15

timer3: Timers.STM32_TimerZephyr @ sysbus 0x40000400
    frequency: 48000000
    initialLimit: 0xFFFF
    -> nvic@16
    2 -> dma@2
    3 -> dma@3
    0 -> dma@4
    UpdateInterrupt -> dma@3
    TriggerInterrupt -> dma@4

timer6: Timers.STM32_TimerZephyr @ sysbus 0x40001000
    frequency: 48000000
    initialLimit: 0xFFFF
    UpdateInterrupt -> dma@3

timer7: Timers.STM32_TimerZephyr @ sysbus 0x40001400
    frequency: 48000000
    initialLimit: 0xFFFF
    -> nvic@18
    UpdateInterrupt -> dma@4

timer14: Timers.STM32_TimerZephyr @ sysbus 0x40002000
    frequency: 48000000
    initialLimit: 0xFFFF
    -> nvic@19

timer15: Timers.STM32_TimerZephyr @ sysbus 0x40014000
    frequency: 48000000
    initialLimit: 0xFFFF
    -> nvic@20
    [0, UpdateInterrupt, TriggerInterrupt, CommutationInterrupt] -> dma@[5, 5, 5, 5]

timer16: Timers.STM32_TimerZephyr @ sysbus 0x40014400
    frequency: 48000000
    initialLimit: 0xFFFF
    -> nvic@21
    0 -> dma@3 | dma@4 // depends on SYSCFG_CFGR1
    UpdateInterrupt -> dma@3 | dma@4 // depends on SYSCFG_CFGR1

timer17: Timers.STM32_TimerZephyr @ sysbus 0x40014800
    frequency: 48000000
    initialLimit: 0xFFFF
    -> nvic@22
    0 -> dma@1 | dma@2 // depends on SYSCFG_CFGR1
    UpdateInterrupt -> dma@1 | dma@2 // depends on SYSCFG_CFGR1

can: CAN.STMCANZephyr @ sysbus <0x40006400, +0x400>
    [0-3] -> canIrq@[0-3]

canIrq: Miscellaneous.CombinedInput @ none
    numberOfInputs: 4
    -> nvic@30

iwdg: Timers.STM32_IndependentWatchdog @ sysbus 0x40003000
    frequency: 40000
    windowOption: true

rtc: Timers.STM32F4_RTC @ sysbus 0x40002800
    // missing TamperIRQ, TimeStampIRQ, WakeupEventIRQ
    AlarmIRQ -> exti@17

rcc: Miscellaneous.STM32F0_RCC @ sysbus 0x40021000

dma: DMA.STM32G0DMA @ sysbus 0x40020000
    numberOfChannels: 5
    [0-4] -> nvic@[9, 10, 10, 11, 11]

adc: Analog.STM32F0_ADC @ sysbus 0x40012400
    referenceVoltage: 3.3
    externalEventFrequency: 1000
    dmaPeripheral: dma
    dmaChannel: 1
    -> nvic@12

crc: CRC.STM32_CRC @ sysbus 0x40023000
    series: STM32Series.F0
    configurablePoly: false // Only STM32F07x and STM32F09x implements configurablePoly: true

// Alternate function mapping connections. For more details see `stm32l071.repl`.
timer1:
    0 -> gpioPortA#07@2 | gpioPortA#08@2 | gpioPortB#13@2
    1 -> gpioPortA#09@2 | gpioPortB#00@2 | gpioPortB#14@2
    2 -> gpioPortA#10@2 | gpioPortB#01@2 | gpioPortB#15@2
    3 -> gpioPortA#11@2

timer3:
    0 -> gpioPortA#06@1 | gpioPortB#04@1 | gpioPortC#06@1
    1 -> gpioPortA#07@1 | gpioPortB#05@1 | gpioPortC#07@1
    2 -> gpioPortB#00@1 | gpioPortC#08@1
    3 -> gpioPortB#01@1 | gpioPortC#09@1

timer14:
    0 -> gpioPortA#04@4 | gpioPortA#07@4 | gpioPortB#01@0

timer15:
    0 -> gpioPortA#01@5 | gpioPortA#02@0 | gpioPortB#14@1 | gpioPortB#15@3
    1 -> gpioPortA#03@0 | gpioPortB#15@1

timer16:
    0 -> gpioPortA#06@5 | gpioPortB#06@2 | gpioPortB#08@2

timer17:
    0 -> gpioPortA#07@5 | gpioPortB#07@2 | gpioPortB#09@2

gpioPortA:
    1 -> timer15@00 | syscfg#0@1
    2 -> timer15@00 | syscfg#0@2
    3 -> timer15@01 | syscfg#0@3
    4 -> timer14@00 | syscfg#0@4
    6 -> timer3@00 | timer16@00 | syscfg#0@6
    7 -> timer1@00 | timer3@01 | timer14@00 | timer17@00 | syscfg#0@7
    8 -> timer1@00 | syscfg#0@8
    9 -> timer1@01 | syscfg#0@9
    10 -> timer1@02 | syscfg#0@10
    11 -> timer1@03 | syscfg#0@11

gpioPortB:
    0 -> timer1@01 | timer3@02 | syscfg#1@0
    1 -> timer1@02 | timer3@03 | timer14@00 | syscfg#1@1
    4 -> timer3@00 | syscfg#1@4
    5 -> timer3@01 | syscfg#1@5
    6 -> timer16@00 | syscfg#1@6
    7 -> timer17@00 | syscfg#1@7
    8 -> timer16@00 | syscfg#1@8
    9 -> timer17@00 | syscfg#1@9
    13 -> timer1@00 | syscfg#1@13
    14 -> timer1@01 | timer15@00 | syscfg#1@14
    15 -> timer1@02 | timer15@00 | timer15@01 | syscfg#1@15

gpioPortC:
    6 -> timer3@00 | syscfg#2@6
    7 -> timer3@01 | syscfg#2@7
    8 -> timer3@02 | syscfg#2@8
    9 -> timer3@03 | syscfg#2@9

sysbus:
    init:
        Tag <0x40002C00, 0x40002FFF> "WWDG"
        Tag <0x40003000, 0x400033FF> "IWDG"
        Tag <0x40005C00, 0x40005FFF> "USB "
        Tag <0x40006000, 0x400063FF> "USB/CAN SRAM"
        Tag <0x40006C00, 0x40006FFF> "CRS"
        Tag <0x40007000, 0x400073FF> "PWR"
        Tag <0x40007400, 0x400077FF> "DAC"
        Tag <0x40007800, 0x40007BFF> "CEC"
        Tag <0x40010000, 0x400103FF> "SYSCFGCOMP"
        Tag <0x40015800, 0x40015BFF> "DBGMCU"
        Tag <0x40020000, 0x400203FF> "DMA"
        Tag <0x40020400, 0x400207FF> "DMA2"
        Tag <0x40022000, 0x400223FF> "FLASH_INTERFACE"
        Tag <0x40023000, 0x400233FF> "CRC"
        Tag <0x40024000, 0x400243FF> "TSC"

// ---- platforms/cpus/stm32f072.repl

flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x20000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x4000

crc:
    configurablePoly: true

// ---- platforms/boards/stm32f072b_discovery.repl

led: Miscellaneous.LED @ gpioPortC 6

gpioPortC:
    6 -> led@0 | syscfg#2@6

button: Miscellaneous.Button @ gpioPortA 
    -> gpioPortA@0
