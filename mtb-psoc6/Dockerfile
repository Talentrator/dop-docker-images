# syntax=docker/dockerfile:1.7
#
# ModusToolbox libraries for the Infineon CY8CKIT-062S2-AI (PSoC 62S2 AI Evaluation
# Kit, CY8C624ABZI-S2D44: Cortex-M4 at 150 MHz + Cortex-M0+, 2 MB flash, 1 MB SRAM),
# built headless with the Arm GNU Toolchain: the agent box and the grader box of a
# task for that kit.
#   Libraries : the board's BSP (TARGET_CY8CKIT-062S2-AI 5.0.1), mtb-pdl-cat1
#               3.19.0, mtb-hal-cat1 2.7.4, core-lib, cmsis, cat1cm0p (CM0+ sleep
#               image), retarget-io, freertos 10.6.202, abstraction-rtos,
#               clib-support: the set Infineon's Arduino core 1.1.0 pins
#   BSP config: config/GeneratedSource, generated by Infineon's Device
#               Configurator 3.60 for PDL 3.19.0, from Infineon's Arduino core
#               (the BSP's design.modus is the same; ModusToolbox generates it at
#               build time with the closed tools package)
#   Examples  : Infineon's HAL hello-world, GPIO interrupt, UART and PWM code
#               examples, and two templates (blinky, blinky_freertos)
#   Tools     : Arm GNU Toolchain 14.3.Rel1 (Armv7E-M libraries only), Ninja and
#               psoc6-build, which builds a ModusToolbox-style application folder;
#               a stand-in start.mk makes `make build` work in a code example
#   Arches    : linux/arm64 and linux/amd64
#
# Every download comes from GitHub (Infineon's release tags) or developer.arm.com
# and is checked against its sha256.
#
# Not in it: the ModusToolbox tools package (Linux x86_64 only, behind an Infineon
# login): no configurators, no project-creator, no library-manager, no OpenOCD.
# Nothing here needs the internet at run time. The bench flashes the kit.
#
# Build (native): docker build -t mtb-psoc6 .

# Declared once, before any stage: the publish workflow reads the version tag from this line
ARG MTB_PDL_VERSION=3.19.0

FROM ubuntu:24.04 AS fetch

ARG TARGETARCH
ARG MTB_PDL_VERSION
ARG ARM_GCC_VERSION=14.3.rel1

ENV LANG=C.UTF-8 LC_ALL=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl xz-utils \
    && rm -rf /var/lib/apt/lists/*

# get URL SHA256 FILE: download and check one file
RUN printf '#!/bin/sh\nset -eu\ncurl -fsSL --retry 5 -o "$3" "$1"\necho "$2  $3" | sha256sum -c -\n' > /usr/local/bin/get \
    && chmod +x /usr/local/bin/get

# Arm GNU Toolchain, per host architecture
RUN set -eux; \
    U=https://developer.arm.com/-/media/Files/downloads/gnu/${ARM_GCC_VERSION}/binrel; \
    case "$TARGETARCH" in \
      amd64) get $U/arm-gnu-toolchain-${ARM_GCC_VERSION}-x86_64-arm-none-eabi.tar.xz 8f6903f8ceb084d9227b9ef991490413014d991874a1e34074443c2a72b14dbd gcc.tar.xz ;; \
      arm64) get $U/arm-gnu-toolchain-${ARM_GCC_VERSION}-aarch64-arm-none-eabi.tar.xz 2d465847eb1d05f876270494f51034de9ace9abe87a4222d079f3360240184d3 gcc.tar.xz ;; \
      *) echo "Unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    mkdir -p /opt/mtb/gcc; \
    tar -xJf gcc.tar.xz --strip-components=1 -C /opt/mtb/gcc; \
    rm gcc.tar.xz; \
    cd /opt/mtb/gcc; \
    # the application core is a Cortex-M4F: of the multilibs, only Armv7E-M's
    for d in arm-none-eabi/lib/thumb lib/gcc/arm-none-eabi/*/thumb; do \
      find "$d" -mindepth 1 -maxdepth 1 -type d ! -name 'v7e-m*' -exec rm -rf {} +; \
    done; \
    rm -rf arm-none-eabi/lib/arm lib/gcc/arm-none-eabi/*/arm share/doc share/info share/man share/gdb \
           bin/arm-none-eabi-gdb* bin/arm-none-eabi-lto-dump libexec/gcc/arm-none-eabi/*/f951 \
           arm-none-eabi/include/c++/*/experimental lib/python* include/gdb

# The libraries, each at its release tag
#   lib NAME REPO TAG SHA256: fetch one library into /opt/mtb/libs/NAME
RUN set -eux; \
    mkdir -p /opt/mtb/libs /opt/mtb/examples; \
    lib() { get https://github.com/Infineon/$2/archive/refs/tags/$3.tar.gz $4 l.tgz; \
            mkdir -p "$1"; tar -xzf l.tgz --strip-components=1 -C "$1"; rm l.tgz; }; \
    cd /opt/mtb/libs; \
    lib TARGET_CY8CKIT-062S2-AI TARGET_CY8CKIT-062S2-AI release-v5.0.1     2d06c7ab751609c231b9b8daf560f2e6ca1f2c757ff8491f5884a58c80e9ecbb; \
    lib mtb-pdl-cat1           mtb-pdl-cat1           release-v${MTB_PDL_VERSION} 0b44edb7796cfeaf239f54b1f5cd05a60583f787e7808de7400643af8d486743; \
    lib mtb-hal-cat1           mtb-hal-cat1           release-v2.7.4      ad915986b3dc7ac8b63019fba1357ca4f85fec425326324cd11e6a53ba5ccf0c; \
    lib core-lib               core-lib               release-v1.6.0      0095367d8a60d6a6257320815ddd540db7f02de76deee35ad38bfc7b34156587; \
    lib cmsis                  cmsis                  release-v6.1.0      fc4255538b84a54c48911b27ae7f4a6a5a77adf40dbe731fd64568ee9f1c3d71; \
    lib cat1cm0p               cat1cm0p               release-v1.9.0      87f7a80d78a449dab7598034b776c42efaaef15b7aaa8b9614eb5a6217e5b0a9; \
    lib retarget-io            retarget-io            release-v1.9.0      4e5b078152d7e638729d02da64182f8d816e3c9b11336c40a80397d021d6f889; \
    lib freertos               freertos               release-v10.6.202   7117773bc67677d9cad2f11a876c88c0f7f2e4d4a3f7d1acbb9d437579621da0; \
    lib abstraction-rtos       abstraction-rtos       release-v1.12.0     2d4cdcba6d7a06312bb831707a26443104c41965203e998c1402129a3aefd1a4; \
    lib clib-support           clib-support           release-v1.8.0      802711bfdc2af54fa2d3528fa0bbb442b35d3fbac589b3b2f6307f485abb5b0a; \
    # the BSP's generated configuration (cycfg_*), from Infineon's Arduino core
    get https://github.com/Infineon/arduino-core-psoc6/archive/refs/tags/1.1.0.tar.gz \
        1c78f0d4d762ed49663a56014a86d4d44b74c63621ebec9b3fd7b7d4a8e17d79 a.tgz; \
    tar -xzf a.tgz arduino-core-psoc6-1.1.0/variants/CY8CKIT-062S2-AI/mtb-bsp/config/GeneratedSource; \
    mv arduino-core-psoc6-1.1.0/variants/CY8CKIT-062S2-AI/mtb-bsp/config/GeneratedSource TARGET_CY8CKIT-062S2-AI/config/; \
    rm -rf a.tgz arduino-core-psoc6-1.1.0; \
    # code examples
    cd /opt/mtb/examples; \
    lib hal-hello-world        mtb-example-hal-hello-world           release-v4.10.0 da3076aede1ebeef8c967566b24d37b8230129564106f2d4444c90b25e8e3c0b; \
    lib hal-gpio-interrupt     mtb-example-hal-gpio-interrupt        release-v3.4.0  969e787885cb78274fce813408bb3b04200b94bbd499cf8b6ac748dbaceed9bd; \
    lib hal-uart-transmit-receive mtb-example-hal-uart-transmit-receive release-v3.5.0 9c06050ac79a2cb74877ba198a0c45daf353986ec9f525e7376bd6584505693a; \
    lib hal-pwm-square-wave    mtb-example-hal-pwm-square-wave       release-v3.4.0  130487f6fa8acaac4a9142c7aa11b59db295f55352a1b60160996ba3570837a2; \
    find /opt/mtb/examples -name images -type d -prune -exec rm -rf {} +; \
    # trims: other chips' PDL device support and docs, other cores' and toolchains' files
    cd /opt/mtb/libs; \
    rm -rf */docs mtb-pdl-cat1/personalities* mtb-pdl-cat1/udd mtb-pdl-cat1/devicesupport.xml \
           cmsis/COMPONENT_CMSIS_NN; \
    find . -type d \( -name 'TOOLCHAIN_ARM' -o -name 'TOOLCHAIN_IAR' -o -name 'TOOLCHAIN_A_Clang' -o -name 'TOOLCHAIN_LLVM_ARM' \) -prune -exec rm -rf {} +; \
    for c in CAT1B CAT1C CAT1D CAT2 CAT3 CAT4 CAT5 PSOC4 XMC7000 TRAVEO; do \
      find . -type d -name "COMPONENT_${c}" -prune -exec rm -rf {} +; \
    done; \
    find mtb-pdl-cat1/devices/COMPONENT_CAT1A/include -maxdepth 1 -type f -name '*.h' \
         \( -name 'cy8c6*' -o -name 'cyb06*' -o -name 'cys06*' -o -name 'cyblepsoc*' \) \
         ! -name 'cy8c624abzi_s2d44*' -delete; \
    find . -name '*.pdf' -delete

# ---------------------------------------------------------------------------
FROM ubuntu:24.04

ARG MTB_PDL_VERSION

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    MTB_DIR=/opt/mtb \
    MTB_LIBS=/opt/mtb/libs \
    MTB_PDL_VERSION=${MTB_PDL_VERSION} \
    CY_TOOLS_PATHS=/opt/mtb/tools_3.0 \
    ARM_GCC_DIR=/opt/mtb/gcc \
    PATH=/opt/mtb/gcc/bin:$PATH

# Ninja and make for the builds, python3-venv for a venv of your own,
# poppler-utils for datasheet PDFs
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates git make ninja-build python3 python3-venv poppler-utils \
        less vim-tiny file xxd \
    && rm -rf /var/lib/apt/lists/*

COPY --from=fetch /opt/mtb /opt/mtb
COPY scripts/tools_3.0/ /opt/mtb/tools_3.0/
COPY scripts/templates/ /opt/mtb/templates/
COPY --chmod=755 scripts/psoc6-build /usr/local/bin/psoc6-build
COPY --chmod=755 scripts/smoke-test.sh /usr/local/bin/psoc6-smoke-test
RUN cp /opt/mtb/libs/freertos/Source/portable/COMPONENT_CM4/FreeRTOSConfig.h /opt/mtb/templates/blinky_freertos/

LABEL org.opencontainers.image.title="mtb-psoc6" \
      org.opencontainers.image.description="ModusToolbox PDL ${MTB_PDL_VERSION} + HAL + BSP for the CY8CKIT-062S2-AI (PSoC 62S2) + Arm GNU Toolchain 14.3.Rel1, with psoc6-build"

WORKDIR /workdir
CMD ["/bin/bash"]
